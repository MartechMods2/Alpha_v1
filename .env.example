# WhatsApp Bot Configuration
# Copy this file to .env and fill in your actual values

# Bot Configuration
PREFIX=-
MY_NUMBER=your_whatsapp_numbers_without_plus
BOT_NUMBER=the_bot_whatsapp_number_without_plus
MODERATORS=number1,number2,number3

# Database
MONGODB_KEY=your_mongodb_connection_string

# Server Configuration
PORT=8000
NODE_ENV=development
HOST_URL=https://your-service.example.com
ADMIN_PASSWORD=
SESSION_SECRET=

# Google APIs
GOOGLE_API_KEY=your_google_gemini_api_key
GOOGLE_API_KEY_SEARCH=your_google_custom_search_api_key
SEARCH_ENGINE_KEY=your_google_search_engine_key
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_MEDIA_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=
NVIDIA_AI_MODEL=openai/gpt-oss-20b

# Third Party APIs
GENIUS_ACCESS_SECRET=your_genius_api_secret
REMOVE_BG_KEY=your_remove_bg_api_key
TRUECALLER_ID=your_truecaller_id
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
JAMENDO_CLIENT_ID=
PEXELS_API_KEY=
GIPHY_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=

# FFmpeg Configuration (Optional)
# Set custom FFmpeg path if ffmpeg-static doesn't work
# Example: FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=

# Telegram Logger
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

#Google OAuth Credentials (Optional, for Admin Dashboard Authentication)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_ALLOWED_EMAILS=your_allowed_email_addresses

# YouTube Download (yt-dlp)
# Optional path to yt-dlp. Leave blank to use system/bundled yt-dlp or the
# official automatic bootstrap fallback.
YTDLP_PATH=
# Keep enabled unless the server policy forbids runtime tool installation.
YTDLP_AUTO_INSTALL=true
# Optional writable directory for the automatic standalone binary.
YTDLP_BOOTSTRAP_DIR=
# Path to a Netscape-format cookies.txt exported from a logged-in browser.
# Prefer the protected dashboard; use this only on a self-hosted server.
YTDLP_COOKIES=

# Redis
# Set USE_REDIS=false to force in-memory cache (no Redis needed)
USE_REDIS=false
# Option A — URL (recommended for Upstash, TLS auto-detected from rediss://)
REDIS_URL=
# Option B — individual fields (redis.io or self-hosted)
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false

# Safe Complete Feature Pack (all optional)
BOT_TIMEZONE=Africa/Lagos
MESSAGE_DELAY_MS=500
GROUP_MESSAGE_DELAY_MS=900
MAX_CONCURRENT_SENDS=2

# Encrypted local/off-site backups. Use a long random secret (32+ chars recommended).
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_COUNT=7
AUTO_BACKUP_ENABLED=false

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, Backblaze, etc.)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Signed, allowlisted outbound operational webhooks
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=

# Optional external fact-check service. Disabled when blank; citations are never invented.
FACTCHECK_API_URL=
FACTCHECK_API_KEY=
